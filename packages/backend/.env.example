# Configure these on your Convex deployment (not NEXT_PUBLIC variables).
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CONTACT_INGEST_SECRET=
REVALIDATE_SECRET=
# Optional email notifications; accepted contact messages always remain in the owner inbox.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Both credential pairs are set in shared Convex chatty-puma-118.
# Existing GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET belong to localhost.
GITHUB_PRODUCTION_CLIENT_ID=
GITHUB_PRODUCTION_CLIENT_SECRET=
